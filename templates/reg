<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login - Upward</title>

<style>

:root{
    --accent:#0a0a0a;
    --bg:#ffffff;
    --text:#0a0a0a;
    --text-secondary:#707070;
    --border:#e8e8e8;
    --sidebar:#0a0a0a;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--bg);
    font-family:Inter,Segoe UI,sans-serif;
    color:var(--text);
}

.container{
    width:min(420px,90%);
    margin:auto;
    padding-top:12vh;
}

.brand{
    font-size:2rem;
    font-weight:900;
    letter-spacing:-1px;
}

.brand span{
    color:var(--accent);
}

.subtitle{
    color:var(--text-secondary);
    margin-top:8px;
    margin-bottom:40px;
}

.form-group{
    margin-bottom:18px;
}

input{
    width:100%;
    padding:14px 16px;

    border:1px solid var(--border);
    border-radius:12px;

    background:white;

    font-size:.95rem;
}

input:focus{
    outline:none;
    border-color:var(--accent);
}

.btn{
    width:100%;
    border:none;

    padding:14px;

    border-radius:12px;

    background:var(--sidebar);
    color:white;

    font-weight:700;
    cursor:pointer;

    margin-top:10px;
}

.btn:hover{
    opacity:.95;
}

.error{
    color:#d33;
    margin-bottom:14px;
    font-size:.9rem;
}

.footer{
    margin-top:24px;
    text-align:center;
    color:var(--text-secondary);
}

.footer a{
    color:var(--accent);
    text-decoration:none;
}

</style>
<link rel="stylesheet" href="/static/brand.css">
</head>

<body>

<div class="container">

    <h1 class="brand">
        UPWARD<span>®</span>
    </h1>

    <p class="subtitle">
        Welcome back.
    </p>

    <form action="/register" method="POST">

        <div class="form-group">
            <input
                type="text"
                name="username"
                placeholder="Username"
                autocomplete="username"
                required>
        </div>

        <div class="form-group">
            <input
                type="email"
                name="email"
                placeholder="Email address"
                autocomplete="email"
                required>
        </div>

        
        <div class="form-group">
        <input
            type="password"
            name="confirmation"
            placeholder="Confirm password"
            autocomplete="new-password"
            required>
        </div>
        {% if error %}
        <p class="error">
            {{ error }}
        </p>
        {% endif %}
        <button class="btn" type="submit">
            Create account
        </button>

    </form>

    <p class="footer">
        Don't have an account?
        <a href="/login">login</a>
    </p>

</div>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script src="/static/brand.js" defer></script>
</body>
</html>